# Copy this file to .env in the repository root.
# agent/llm.py loads these values. Exported environment variables take priority.
# Start the model endpoint separately. The default uses `opencode serve`.
BLOCKBUDDY_BASE_URL=http://localhost:4096/v1
BLOCKBUDDY_API_KEY=
BLOCKBUDDY_MODEL=opencode-default
# Optional comma-separated fallback model names.
BLOCKBUDDY_FALLBACK_CHAIN=

# Minecraft instance directory for the installer and pack tools.
# Export this value in your shell before you run tools/install_bridge.py.
BLOCKBUDDY_MC_DIR=/path/to/instance/minecraft
# Legacy quest planner body selection. Do not start it beside hermes_bridge.py.
BLOCKBUDDY_BODY=companion

# Optional wiki gateway. Empty values disable external wiki access.
HERMES_URL=
HERMES_API_KEY=

# Optional host audio. Chat works without these packages or model files.
# Install kokoro-onnx and sounddevice separately before you enable audio.
# Supply local model files. The runtime does not download them.
BLOCKBUDDY_TTS=0
BLOCKBUDDY_KOKORO_MODEL=
BLOCKBUDDY_KOKORO_VOICES=
BLOCKBUDDY_KOKORO_VOICE=af_heart
BLOCKBUDDY_KOKORO_SPEED=1.0
